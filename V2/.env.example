# Expense Tracker v2 — environment template
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# Basic-auth credentials for the Traefik middleware (htpasswd format).
# Generate with:  htpasswd -nb <user> <password>
# IMPORTANT: in docker-compose, every literal `$` must be doubled to `$$`.
# Example (user "admin", bcrypt hash): admin:$$2y$$05$$abcdefghijklmnopqrstuv
EXPENSES_AUTH=Helmwill:$2y$05$VbCDcn.3n5b3ynnq1l9gcu3KTLnEAKryjv/7Umm4uI8rl9NeexTdS

# Path inside the container where the SQLite DB lives (on the named volume).
# App code reads this in Stage 2; volume is already mounted at /data.
DATABASE_PATH=/data/expenses.db
